<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prismo_background">

    <!-- ═══ MAP (full screen behind everything) ═══ -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ═══ TOP OVERLAY — MGRS + status ═══ -->
    <LinearLayout android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/prismo_sheet"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:paddingTop="4dp"
        android:layout_gravity="top">

        <!-- Header row: title + connection dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRISMO / TAK Bridge"
                android:textColor="@color/prismo_teal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- USB dot -->
            <View
                android:id="@+id/usbStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/usbStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB"
                android:textColor="@color/prismo_muted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="10dp" />

            <!-- Multicast dot -->
            <View
                android:id="@+id/multicastDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/multicastLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local"
                android:textColor="@color/prismo_muted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="10dp" />

            <!-- TCP dot -->
            <View
                android:id="@+id/tcpDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tcpLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAK"
                android:textColor="@color/prismo_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Coordinate format label (tap to cycle) -->
        <TextView
            android:id="@+id/coordFormatLabel" android:minHeight="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MGRS  ▼"
            android:textColor="@color/prismo_teal"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Primary coordinate (big, tap to cycle format) -->
        <TextView
            android:id="@+id/mgrsText" android:minHeight="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-- --- ----- -----"
            android:textColor="@color/prismo_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="0dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Lat/Lon + metadata row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/latLonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---.------ / ---.------"
                android:textColor="@color/prismo_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#444444"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/fixText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Fix"
                android:textColor="@color/prismo_red"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  "
                android:textSize="11sp" />

            <TextView
                android:id="@+id/satsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0sv"
                android:textColor="@color/prismo_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Speed / Alt / Heading / CoT rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/spdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 m/s"
                android:textColor="@color/prismo_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#444444"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/altText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0m MSL"
                android:textColor="@color/prismo_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#444444"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hdgText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDG 000°"
                android:textColor="@color/prismo_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#444444"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cotRateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CoT: 0"
                android:textColor="@color/prismo_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <com.dronewukong.takbridge.ui.ConnectionPanel android:id="@+id/bottomPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/prismo_sheet" android:padding="12dp" android:layout_gravity="bottom">
<ScrollView android:id="@+id/connectionSettings" android:layout_width="match_parent" android:layout_height="280dp" android:visibility="gone" android:fillViewport="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USB input" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/prismo_muted" android:layout_marginTop="8dp" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Spinner android:id="@+id/spinnerConnectionProfile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="USB connection profile" android:backgroundTint="@color/prismo_teal" /><CheckBox android:id="@+id/checkDtr" android:layout_width="wrap_content" android:layout_height="48dp" android:text="DTR" android:textSize="13sp" android:textColor="@color/prismo_text" android:buttonTint="@color/prismo_teal" /></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Protocol / baud rate" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/prismo_muted" android:layout_marginTop="8dp" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Spinner android:id="@+id/spinnerProtocol" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="Telemetry protocol" android:backgroundTint="@color/prismo_teal" /><Spinner android:id="@+id/spinnerBaud" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="USB baud rate" android:backgroundTint="@color/prismo_teal" /></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Callsign" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/prismo_muted" android:layout_marginTop="8dp" /><EditText android:id="@+id/editCallsign" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Callsign" android:contentDescription="Callsign" android:text="DRONE-01" android:textSize="16sp" android:textColor="@color/prismo_text" android:textColorHint="@color/prismo_muted" android:backgroundTint="@color/prismo_teal" android:inputType="textCapCharacters" android:padding="8dp" android:singleLine="true" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TAK destination" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/prismo_muted" android:layout_marginTop="8dp" /><EditText android:id="@+id/editTakHost" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Server hostname / IP" android:contentDescription="Server hostname / IP" android:text="" android:textSize="16sp" android:textColor="@color/prismo_text" android:textColorHint="@color/prismo_muted" android:backgroundTint="@color/prismo_teal" android:inputType="text" android:padding="8dp" android:singleLine="true" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><EditText android:id="@+id/editTakPort" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:hint="Server port" android:contentDescription="Server port" android:text="8087" android:textSize="16sp" android:textColor="@color/prismo_text" android:textColorHint="@color/prismo_muted" android:backgroundTint="@color/prismo_teal" android:inputType="number" android:padding="8dp" android:singleLine="true" /><CheckBox android:id="@+id/checkTls" android:layout_width="wrap_content" android:layout_height="48dp" android:text="TLS" android:textSize="13sp" android:textColor="@color/prismo_text" android:buttonTint="@color/prismo_teal" /><CheckBox android:id="@+id/checkMulticast" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Local TAK" android:textSize="13sp" android:textColor="@color/prismo_text" android:buttonTint="@color/prismo_teal" /></LinearLayout><Button android:id="@+id/btnLoadCert" android:layout_width="match_parent" android:layout_height="52dp" android:text="Certificates" android:textAllCaps="false" android:backgroundTint="@color/prismo_panel" android:textColor="@color/prismo_teal" android:visibility="gone" />
<TextView android:id="@+id/certStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/prismo_muted" android:textSize="12sp" android:visibility="gone" />
</LinearLayout></ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Button android:id="@+id/btnConnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Connect" android:textAllCaps="false" android:textSize="13sp" android:minWidth="0dp" android:backgroundTint="@color/prismo_cream" android:textColor="@color/prismo_background" /><Button android:id="@+id/btnTakConnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Send to TAK" android:textAllCaps="false" android:textSize="13sp" android:minWidth="0dp" android:backgroundTint="@color/prismo_panel" android:textColor="@color/prismo_teal" /></LinearLayout><Button android:id="@+id/btnConnectionSettings" android:layout_width="match_parent" android:layout_height="48dp" android:text="Connection settings +" android:textAllCaps="false" android:textSize="13sp" android:backgroundTint="@color/prismo_panel" android:textColor="@color/prismo_text" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Button android:id="@+id/btnReplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Software demo" android:textAllCaps="false" android:textSize="13sp" android:minWidth="0dp" android:backgroundTint="@color/prismo_panel" android:textColor="@color/prismo_teal" /><Button android:id="@+id/btnDiagnostics" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Diagnostics" android:textAllCaps="false" android:textSize="13sp" android:minWidth="0dp" android:backgroundTint="@color/prismo_panel" android:textColor="@color/prismo_teal" /></LinearLayout><TextView android:id="@+id/statusBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready · connect an existing telemetry stream" android:textColor="@color/prismo_muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="4dp" />
<TextView android:id="@+id/protocolStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/prismo_muted" android:textSize="11sp" android:gravity="center" />
</com.dronewukong.takbridge.ui.ConnectionPanel>

    <!-- ═══ MAP CONTROLS (right edge) ═══ -->
    <LinearLayout android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp">

        <Button
            android:id="@+id/btnCenterDrone" android:contentDescription="Follow aircraft"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="◎"
            android:textSize="20sp"
            android:backgroundTint="@color/prismo_panel"
            android:textColor="@color/prismo_teal"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnZoomIn" android:contentDescription="Zoom in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textSize="20sp"
            android:backgroundTint="@color/prismo_panel"
            android:textColor="@color/prismo_text"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnZoomOut" android:contentDescription="Zoom out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="−"
            android:textSize="20sp"
            android:backgroundTint="@color/prismo_panel"
            android:textColor="@color/prismo_text" />
    </LinearLayout>

</FrameLayout>
